rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner is one Google account: signed in through Google, email verified.
    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'marcelinofahmyatiia@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Shape and size limits for a game document (matches what the dashboard writes).
    function validGame() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.desc is string && d.desc.size() <= 5000
        && d.hidden is bool
        && d.versions is list && d.versions.size() > 0 && d.versions.size() <= 200
        && d.screenshots is list && d.screenshots.size() <= 12;
    }

    match /games/{gameId} {
      // Visitors only see published games. Hidden drafts are readable by the owner only.
      allow read: if resource.data.hidden == false || isOwner();
      allow create, update: if isOwner()
        && gameId.matches('^[a-z0-9-]+$') && gameId.size() <= 80
        && validGame();
      allow delete: if isOwner();
    }

    // Push-notification subscribers. Visitors can add, change or remove only their own record
    // (the document id is their private device token). Nobody but the server can list or read them.
    function validSub() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mode', 'games', 'updated'])
        && d.mode in ['all', 'mine']
        && d.games is list && d.games.size() <= 50
        && d.updated == request.time;
    }
    match /subscribers/{token} {
      allow create, update: if token.size() > 20 && token.size() < 500 && validSub();
      allow delete: if true;
      allow read: if false;
    }

    // Download counter and star ratings: one document per game, plus "_site" for the site rating. Ratings are 0.5 to 5 stars and are stored in
    // half-star units: halfSum (new votes) plus ratingSum (whole stars from the first version), ratingCount = number of voters.
    // Visitors may only count one download (+1), add one rating, or change their own rating; the owner can set anything.
    function statsKeys() {
      let d = request.resource.data;
      return d.keys().hasOnly(['downloads', 'ratingSum', 'ratingCount', 'halfSum'])
        && d.keys().hasAll(['downloads', 'ratingSum', 'ratingCount'])
        && d.downloads is int && d.ratingSum is int && d.ratingCount is int && d.get('halfSum', 0) is int;
    }
    function halfDelta() {
      return request.resource.data.get('halfSum', 0) - resource.data.get('halfSum', 0);
    }
    function totalOk() {      // every voter gave between 0.5 and 5 stars
      let d = request.resource.data;
      let total = 2 * d.ratingSum + d.get('halfSum', 0);
      return total >= d.ratingCount && total <= 10 * d.ratingCount;
    }
    match /stats/{gameId} {
      allow read: if true;
      allow create: if (gameId == '_site'
          || (gameId.matches('^[a-z0-9-]+$') && gameId.size() <= 80
              && exists(/databases/$(database)/documents/games/$(gameId))))
        && statsKeys()
        && request.resource.data.ratingSum == 0
        && ((request.resource.data.downloads == 1 && request.resource.data.ratingCount == 0 && request.resource.data.get('halfSum', 0) == 0)
         || (request.resource.data.downloads == 0 && request.resource.data.ratingCount == 1
             && request.resource.data.get('halfSum', 0) >= 1 && request.resource.data.get('halfSum', 0) <= 10));
      allow update: if isOwner()
        || (statsKeys() && totalOk()
          && request.resource.data.ratingSum == resource.data.ratingSum
          && (
            // one more download
            (request.resource.data.downloads == resource.data.downloads + 1
             && request.resource.data.ratingCount == resource.data.ratingCount
             && halfDelta() == 0)
            // a new rating, 0.5 to 5 stars
            || (request.resource.data.downloads == resource.data.downloads
             && request.resource.data.ratingCount == resource.data.ratingCount + 1
             && halfDelta() >= 1 && halfDelta() <= 10)
            // a visitor changing their own rating
            || (request.resource.data.downloads == resource.data.downloads
             && request.resource.data.ratingCount == resource.data.ratingCount
             && halfDelta() != 0 && halfDelta() >= -9 && halfDelta() <= 9)));
      allow delete: if isOwner();
    }

    // Public complaints board. Anyone can post a complaint, comment, and like / dislike (counters move by 1);
    // only the owner can delete anything or edit the text.
    function validComplaint() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'text', 'game', 'created', 'likes', 'dislikes', 'comments'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.text is string && d.text.size() >= 3 && d.text.size() <= 1000
        && d.game is string && d.game.size() <= 80
        && d.created == request.time
        && d.likes == 0 && d.dislikes == 0 && d.comments == 0;
    }
    function validReact() {
      let a = resource.data;
      let b = request.resource.data;
      return b.diff(a).affectedKeys().hasOnly(['likes', 'dislikes', 'comments'])
        && b.likes is int && b.dislikes is int && b.comments is int
        && b.likes >= 0 && b.dislikes >= 0 && b.comments >= 0
        && b.likes - a.likes >= -1 && b.likes - a.likes <= 1
        && b.dislikes - a.dislikes >= -1 && b.dislikes - a.dislikes <= 1
        && b.comments - a.comments >= 0 && b.comments - a.comments <= 1;
    }
    function validComment() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'text', 'created'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && d.created == request.time;
    }
    match /complaints/{cid} {
      allow read: if true;
      allow create: if validComplaint();
      allow update: if isOwner() || validReact();
      allow delete: if isOwner();

      match /comments/{mid} {
        allow read: if true;
        allow create: if validComment() && exists(/databases/$(database)/documents/complaints/$(cid));
        allow delete: if isOwner();
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
