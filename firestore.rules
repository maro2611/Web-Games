rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner is one Google account: signed in through Google, email verified.
    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'marcelinofahmyatiia@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Shape and size limits for a game document (matches what the dashboard writes).
    function validGame() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.desc is string && d.desc.size() <= 5000
        && d.hidden is bool
        && d.versions is list && d.versions.size() > 0 && d.versions.size() <= 200
        && d.screenshots is list && d.screenshots.size() <= 12;
    }

    match /games/{gameId} {
      // Visitors only see published games. Hidden drafts are readable by the owner only.
      allow read: if resource.data.hidden == false || isOwner();
      allow create, update: if isOwner()
        && gameId.matches('^[a-z0-9-]+$') && gameId.size() <= 80
        && validGame();
      allow delete: if isOwner();
    }

    // Push-notification subscribers. Visitors can add, change or remove only their own record
    // (the document id is their private device token). Nobody but the server can list or read them.
    function validSub() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mode', 'games', 'updated'])
        && d.mode in ['all', 'mine']
        && d.games is list && d.games.size() <= 50
        && d.updated == request.time;
    }
    match /subscribers/{token} {
      allow create, update: if token.size() > 20 && token.size() < 500 && validSub();
      allow delete: if true;
      allow read: if false;
    }

    // Download counter and star ratings: one document per game. Visitors may only count one download
    // (+1), add one rating (1 to 5 stars) or change their own rating; only the owner can set other values or reset.
    function statsKeys() {
      let d = request.resource.data;
      return d.keys().hasOnly(['downloads', 'ratingSum', 'ratingCount']) && d.keys().hasAll(['downloads', 'ratingSum', 'ratingCount'])
        && d.downloads is int && d.ratingSum is int && d.ratingCount is int;
    }
    match /stats/{gameId} {
      allow read: if true;
      allow create: if gameId.matches('^[a-z0-9-]+$') && gameId.size() <= 80
        && exists(/databases/$(database)/documents/games/$(gameId))
        && statsKeys()
        && ((request.resource.data.downloads == 1 && request.resource.data.ratingSum == 0 && request.resource.data.ratingCount == 0)
         || (request.resource.data.downloads == 0 && request.resource.data.ratingCount == 1
             && request.resource.data.ratingSum >= 1 && request.resource.data.ratingSum <= 5));
      allow update: if isOwner()
        || (statsKeys()
          && ((request.resource.data.downloads == resource.data.downloads + 1
               && request.resource.data.ratingSum == resource.data.ratingSum
               && request.resource.data.ratingCount == resource.data.ratingCount)
           || (request.resource.data.downloads == resource.data.downloads
               && request.resource.data.ratingCount == resource.data.ratingCount + 1
               && request.resource.data.ratingSum >= resource.data.ratingSum + 1
               && request.resource.data.ratingSum <= resource.data.ratingSum + 5)
           || (request.resource.data.downloads == resource.data.downloads
               && request.resource.data.ratingCount == resource.data.ratingCount
               && request.resource.data.ratingSum != resource.data.ratingSum
               && request.resource.data.ratingSum >= resource.data.ratingSum - 4
               && request.resource.data.ratingSum <= resource.data.ratingSum + 4
               && request.resource.data.ratingSum >= request.resource.data.ratingCount
               && request.resource.data.ratingSum <= request.resource.data.ratingCount * 5)));
      allow delete: if isOwner();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
